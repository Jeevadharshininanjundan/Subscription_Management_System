NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
SERVICE_NAME=brightloop-subscription-server
MONGO_URI=mongodb://127.0.0.1:27017/brightloop_subscription
MONGO_TEST_URI=mongodb://127.0.0.1:27017/brightloop_subscription_test
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=brightloop-subscription
JWT_AUDIENCE=brightloop-client
JWT_EXPIRES_IN=15m
MAIL_FROM=no-reply@brightloop.local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
